# The site's own origin, used for canonical URLs, Open Graph images, robots.txt
# and the sitemap. See app/site.ts for the full resolution order.
#
# Leave this unset on Vercel: the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL (the project's stable *.vercel.app domain) and
# then to VERCEL_URL for preview builds, both of which Vercel injects for you.
#
# Set it — in the Vercel dashboard, Production environment only — the day a real
# domain is pointed at the project. Getting this wrong fails quietly: pages
# still render, but every share preview points at the wrong host.
#
# NEXT_PUBLIC_SITE_URL=https://example.com
